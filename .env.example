# Provider credentials (use GitHub Actions Secrets in hosted runs).
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Provider order and model overrides (empty model values use code defaults).
AI_PROVIDER_ORDER=gemini,groq,openrouter,cloudflare
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_MODEL=openrouter/free
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
OPENROUTER_HTTP_REFERER=

# Per-run generation and per-provider request budgets.
AI_MAX_GENERATIONS_PER_RUN=6
AI_MAX_RETRIES=1
AI_TIMEOUT_SECONDS=90
AI_RETRY_BASE_SECONDS=2
AI_MAX_RETRY_DELAY_SECONDS=30
AI_MAX_TOKENS=3500
AI_GEMINI_MAX_REQUESTS=12
AI_GROQ_MAX_REQUESTS=12
AI_OPENROUTER_MAX_REQUESTS=12
AI_CLOUDFLARE_MAX_REQUESTS=12

# Source collection and inbox retry policy.
MAX_ITEMS_PER_SOURCE=8
GENERATION_DELAY=4
INBOX_MAX_ATTEMPTS=8
INBOX_RETRY_BASE_SECONDS=3600
INBOX_RETRY_MAX_SECONDS=86400
LOG_LEVEL=INFO
